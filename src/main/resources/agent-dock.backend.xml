<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="intellij.platform.rpc.backend"/>
        <module name="intellij.platform.vcs"/>
        <module name="agent-dock.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="agentdock.acp.AcpQuotaService"/>
        <projectService serviceInterface="agentdock.rpc.LocalBridgeHost"
                        serviceImplementation="agentdock.bridge.BridgeHost"/>
        <postStartupActivity implementation="agentdock.acp.AcpStartupActivity"/>
        <platform.rpc.backend.remoteApiProvider implementation="agentdock.bridge.AgentDockRemoteApiProvider"/>
    </extensions>
</idea-plugin>
