{
  "id": "qoder",
  "name": "Qoder",
  "iconPath": "/icons/qoder.svg",
  "iconPathLight": "/icons/qoder-light.svg",
  "iconPathDark": "/icons/qoder-dark.svg",
  "supportsSessionList": true,
  "loginMethod": "cli",
  "loginStatusMethod": "qoderCliStatus",
  "distribution": {
    "type": "npm",
    "version": "latest",
    "minimumVersion": "1.0.0",
    "packageName": "@qoder-ai/qodercli"
  },
  "launchBinary": {
    "win": "node_modules/.bin/qodercli.cmd",
    "unix": "node_modules/.bin/qodercli"
  },
  "args": [
    "--acp"
  ],
  "cli": {
    "executable": {
      "win": "node_modules/.bin/qodercli.cmd",
      "unix": "node_modules/.bin/qodercli"
    },
    "resumeArgs": [
      "-r",
      "{sessionId}"
    ]
  }
}
