{
  "id": "codex",
  "name": "Codex",
  "iconPath": "/icons/codex.svg",
  "iconPathLight": "/icons/codex-light.svg",
  "iconPathDark": "/icons/codex-dark.svg",
  "distribution": {
    "type": "npm",
    "version": "latest",
    "packageName": "@agentclientprotocol/codex-acp"
  },
  "launchBinary": {
    "win": "node_modules\\.bin\\codex-acp.cmd",
    "unix": "node_modules/.bin/codex-acp"
  },
  "disabledModels": [
    "-5.3",
    "-5.1",
    "-5.2"
  ],
  "disabledModes": [],
  "agentVersionConfig": {
    "args": ["--version"],
    "pattern": "(\\d+\\.\\d+[\\d.\\-]*)"
  },
  "authConfig": {
    "statusMethod": "cliAuthStatus",
    "loginMethod": "cliLogin",
    "logoutMethod": "cliLogout",
    "authNpmPackage": "@openai/codex",
    "statusArgs": [
      "login",
      "status"
    ],
    "loginArgs": [
      "login"
    ],
    "logoutArgs": [
      "logout"
    ]
  },
  "cli": {
    "executable": {
      "win": "node_modules\\.bin\\codex.cmd",
      "unix": "node_modules/.bin/codex"
    },
    "resumeArgs": [
      "resume",
      "{sessionId}"
    ]
  }
}
