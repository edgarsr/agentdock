{
  "id": "codex",
  "name": "Codex",
  "iconPath": "/icons/codex.svg",
  "iconPathLight": "/icons/codex-light.svg",
  "iconPathDark": "/icons/codex-dark.svg",
  "distribution": {
    "type": "npm",
    "version": "latest",
    "packageName": "@agentclientprotocol/codex-acp"
  },
  "launchBinary": {
    "win": "node_modules\\.bin\\codex-acp.cmd",
    "unix": "node_modules/.bin/codex-acp"
  },
  "disabledModels": [
    "-5.3"
  ],
  "disabledModes": [],
  "loginMethod": "acp",
  "logoutMethod": "acp",
  "loginStatusMethod": "codexCliLoginStatus",
  "agentVersionConfig": {
    "args": ["--version"],
    "pattern": "(\\d+\\.\\d+[\\d.\\-]*)",
    "command": "cli"
  },
  "cli": {
    "executable": {
      "win": "node_modules\\.bin\\codex.cmd",
      "unix": "node_modules/.bin/codex"
    },
    "resumeArgs": [
      "resume",
      "{sessionId}"
    ]
  }
}
