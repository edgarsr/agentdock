{
  "id": "cursor-cli",
  "name": "Cursor",
  "iconPath": "/icons/cursor.svg",
  "iconPathLight": "/icons/cursor-light.svg",
  "iconPathDark": "/icons/cursor-dark.svg",
  "sessionDeleteMethod": "cursorSessionDirDelete",
  "distribution": {
    "type": "archive",
    "version": "latest",
    "downloadUrl": "https://downloads.cursor.com/lab/{version}/{platform}/{arch}/agent-cli-package.{ext}",
    "binaryName": {
      "win": "cursor-agent.cmd",
      "unix": "cursor-agent"
    },
    "extractSubdir": "dist-package"
  },
  "clientCapabilitiesMeta": {
    "parameterizedModelPicker": true
  },
  "args": [
    "acp"
  ],
  "logoutMethod": "cli",
  "loginStatusMethod": "cursorCliStatus",
  "cli": {
    "executable": {
      "win": "cursor-agent.cmd",
      "unix": "./cursor-agent"
    }
  }
}
