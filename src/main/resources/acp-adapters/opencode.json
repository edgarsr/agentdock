{
  "id": "opencode",
  "name": "OpenCode v2",
  "iconPath": "/icons/opencode.svg",
  "iconPathLight": "/icons/opencode-light.svg",
  "iconPathDark": "/icons/opencode-dark.svg",
  "distribution": {
    "type": "npm",
    "version": "latest",
    "minimumVersion": "2.0.0",
    "packageName": "@opencode/cli"
  },
  "launchBinary": {
    "win": "node_modules/.bin/opencode.cmd",
    "unix": "node_modules/.bin/opencode"
  },
  "sessionDeleteMethod": "acp",
  "args": [
    "acp"
  ],
  "cli": {
    "executable": {
      "win": "node_modules/.bin/opencode.cmd",
      "unix": "node_modules/.bin/opencode"
    },
    "resumeArgs": [
      "--session",
      "{sessionId}"
    ]
  },
  "disabledModels": [
    "gpt-5.1",
    "gpt-5.2",
    "gpt-5.3",
    "gemini-2.5"
  ]
}
