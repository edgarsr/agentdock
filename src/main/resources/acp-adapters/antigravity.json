{
  "id": "antigravity",
  "name": "Google Antigravity",
  "iconPath": "/icons/antigravity.svg",
  "sessionListPosixCwd": true,
  "sessionDeleteMethod": "antigravitySessionDelete",
  "loginMethod": "acp",
  "logoutMethod": "acp",
  "loginStatusMethod": "antigravityAuthFile",
  "distribution": {
    "type": "archive",
    "version": "latest",
    "downloadUrl": "https://dl.google.com/agy-extensions/releases/{osDir}/agy-acp-server-{version}-{platform}-{archToken}.zip",
    "binaryName": {
      "win": "agy_acp_server.exe",
      "unix": "agy_acp_server.par"
    }
  },
  "platformArgs": {
    "linux": ["--uid="]
  },
  "cli": {
    "executable": {
      "win": "agy",
      "unix": "agy"
    },
    "minimumVersion": "1.1.11"
  }
}
