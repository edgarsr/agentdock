{
  "id": "antigravity",
  "name": "Google Antigravity",
  "iconPath": "/icons/antigravity.svg",
  "sessionListPosixCwd": true,
  "restartAfterProbe": true,
  "loginMethod": "acp",
  "logoutMethod": "acp",
  "loginStatusMethod": "antigravityCliModels",
  "distribution": {
    "type": "archive",
    "version": "latest",
    "manifestUrl": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/{platform}_{goArch}.json",
    "binaryName": {
      "win": "agy.exe",
      "unix": "antigravity"
    }
  },
  "args": ["acp"],
  "environment": {
    "AGY_CLI_DISABLE_AUTO_UPDATE": "true"
  },
  "cli": {
    "executable": {
      "win": "agy.exe",
      "unix": "antigravity"
    },
    "resumeArgs": ["--conversation", "{sessionId}"],
    "logFileArg": "--log-file",
    "environment": {
      "AGY_CLI_DISABLE_AUTO_UPDATE": "true"
    }
  }
}
