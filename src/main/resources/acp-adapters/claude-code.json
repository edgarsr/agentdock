{
  "id": "claude-code",
  "name": "Claude Code",
  "iconPath": "/icons/claude.svg",
  "distribution": {
    "type": "npm",
    "version": "latest",
    "packageName": "@agentclientprotocol/claude-agent-acp"
  },
  "disabledModels": [],
  "disabledModes": [],
  "loginMethod": "acp",
  "logoutMethod": "acp",
  "loginStatusMethod": "claudeCodeCliAuthStatus",
  "patches": [
    "@patches/claude-code/disable-auto-updater.patch",
    "@patches/claude-code/powershell-tool-kind.patch",
    "@patches/claude-code/powershell-tool-result.patch"
  ],
  "cli": {
    "executable": {
      "win": "node.exe",
      "unix": "node"
    },
    "entryPath": "node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js",
    "args": [
      "--cli"
    ],
    "resumeArgs": [
      "-r",
      "{sessionId}"
    ]
  },
  "modelChangeStrategy": "restart-resume",
  "agentVersionConfig": {
    "args": ["--cli", "--version"],
    "pattern": "(\\d+\\.\\d+[\\d.\\-]*)"
  }
}
