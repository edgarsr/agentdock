{
  "id": "github-copilot-cli",
  "name": "GitHub Copilot",
  "iconPath": "/icons/copilot.svg",
  "iconPathLight": "/icons/copilot-light.svg",
  "iconPathDark": "/icons/copilot-dark.svg",
  "sessionListPosixCwd": true,
  "distribution": {
    "type": "npm",
    "version": "1.0.75",
    "minimumVersion": "1.0.75",
    "packageName": "@github/copilot"
  },
  "launchPath": "npm-loader.js",
  "args": [
    "--acp",
    "--stdio"
  ],
  "patchRoot": "runtime",
  "patches": [
    "@patches/github-copilot-cli/acp-load-session-reuse.patch"
  ],
  "disabledModes": [],
  "disabledModels": [],
  "logoutMethod": "copilotRpc",
  "loginStatusMethod": "copilotRpcAuthStatus",
  "cli": {
    "executable": {
      "win": "node_modules/.bin/copilot.cmd",
      "unix": "node_modules/.bin/copilot"
    },
    "resumeArgs": [
      "--resume",
      "{sessionId}"
    ]
  }
}
