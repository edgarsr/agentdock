{
  "id": "grok-build",
  "name": "Grok Build",
  "iconPath": "/icons/grok-build.svg",
  "iconPathLight": "/icons/grok-build-light.svg",
  "iconPathDark": "/icons/grok-build-dark.svg",
  "supportsSessionList": true,
  "sessionListMethod": "grokCliSessions",
  "sessionDeleteMethod": "grokCliSessionDelete",
  "loginMethod": "acp",
  "logoutMethod": "cli",
  "loginStatusMethod": "grokBuildAuthFile",
  "configOptions": [
    {
      "id": "model",
      "name": "Model",
      "options": [
        { "value": "grok-4.6", "name": "Grok 4.6", "description": "SpaceXAI's latest frontier model" }
      ]
    },
    {
      "id": "reasoning_effort",
      "name": "Reasoning Effort",
      "metaKey": "reasoningEffort",
      "options": [
        { "value": "low" },
        { "value": "medium" },
        { "value": "high" },
        { "value": "xhigh" }
      ]
    }
  ],
  "distribution": {
    "type": "npm",
    "version": "latest",
    "minimumVersion": "1.0.4",
    "packageName": "@xai-official/grok"
  },
  "launchBinary": {
    "win": "node_modules/.bin/grok.cmd",
    "unix": "node_modules/.bin/grok"
  },
  "args": [
    "--no-auto-update",
    "agent",
    "stdio"
  ],
  "agentVersionConfig": {
    "args": [
      "version"
    ],
    "pattern": "(\\d+\\.\\d+[\\d.\\-]*)"
  },
  "cli": {
    "executable": {
      "win": "node_modules/.bin/grok.cmd",
      "unix": "node_modules/.bin/grok"
    },
    "resumeArgs": [
      "--resume",
      "{sessionId}"
    ]
  }
}
